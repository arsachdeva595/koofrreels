# ── Koofr ─────────────────────────────────────────────────────────────────────
# NOT a developer API key — use your Koofr email + an application password.
# Generate one at: https://app.koofr.net/app/admin/preferences/password
# Click "Add application password", name it "KoofrReels", copy the password.
KOOFR_EMAIL=your@email.com
KOOFR_APP_PASSWORD=generated-app-password-here
KOOFR_BASE_URL=https://app.koofr.net/api/v2

# ── Anthropic ──────────────────────────────────────────────────────────────────
# For "describe" mode clip scoring and text overlay generation.
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Publer (optional) ──────────────────────────────────────────────────────────
# Required only if you want to push reels to Publer scheduler.
# Get API key: Publer → Settings → Access & Login → API Keys
# Workspace ID: visible in the URL → app.publer.io/workspaces/YOUR_ID
PUBLER_API_KEY=
PUBLER_WORKSPACE_ID=

# ── Pexels (optional) ──────────────────────────────────────────────────────────
# Used for gap-fill when Koofr has no matching clips for a describe query.
# Free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Local paths ────────────────────────────────────────────────────────────────
MUSIC_LIBRARY_PATH=./music
PROJECTS_DIR=./projects
PIPELINE_DEFS_DIR=./pipeline_defs
SCHEMAS_DIR=./schemas
SKILLS_DIR=./skills
